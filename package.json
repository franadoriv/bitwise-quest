{
  "name": "bitwise-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Bitwise Quest: a retro arcade game for learning programming languages by playing. First cartridge: Rust. English, Espa\u00f1ol, \u65e5\u672c\u8a9e.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "node scripts/validate-content.ts",
    "content:verify": "node scripts/validate-content.ts --verify",
    "playtest": "node scripts/playtest.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "e2e": "node scripts/e2e-memory-card.mjs",
    "shots": "node scripts/shots.mjs",
    "postinstall": "node scripts/copy-pyodide.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "pyodide": "314.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sucrase": "^3.35.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5"
  }
}
